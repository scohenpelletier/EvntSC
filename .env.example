# Copy to .env.local and fill in. Never commit .env.local.
# NEXT_PUBLIC_* values are inlined at build time: restart `npm run dev` / rebuild after changing them.

# --- Supabase (accounts + saved plans) ---------------------------------------
# Project Settings -> API. The publishable (or legacy anon) key is safe for the browser;
# row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   # alternative to the publishable key

# Service-role key: ONLY used by `npm run check:authz` to create/delete two throwaway
# test users. The app itself never reads it. Keep it out of any client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (optional) ------------------------------------------------------------
# Server-only. With no key, EvntSC runs in manual/template mode.
# AI_PROVIDER picks the adapter: "gemini" or "anthropic". If unset, whichever key is set wins.
AI_PROVIDER=gemini

# Google Gemini: free key from https://aistudio.google.com/apikey
# (free tier: Google may use inputs to improve its products; don't paste private data).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic Claude (alternative):
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Demo / testing (optional) -----------------------------------------------
# Pin "today" (America/Los_Angeles) for demos, e.g. 2026-11-12. Leave unset normally.
# NEXT_PUBLIC_REFERENCE_DATE=
# For check:authz app-route checks (dev server must be running):
# APP_URL=http://localhost:3000

# --- TroyLens (optional extension) -------------------------------------------
# "true" turns on public event cards + /discover. Requires supabase/migrations/0002_event_listings.sql.
# Leave unset/false and EvntSC works exactly as before. Restart the dev server after changing.
NEXT_PUBLIC_ENABLE_TROYLENS=

# Optional: official USC display font (Adobe Caslon Pro) via your own Adobe Fonts web project.
# Create a web project at fonts.adobe.com containing Adobe Caslon Pro, add your site's domain(s)
# (and localhost), and paste the project ID (e.g. abc1def). Leave blank to use the free Libre Caslon fallback.
NEXT_PUBLIC_ADOBE_FONTS_KIT=
